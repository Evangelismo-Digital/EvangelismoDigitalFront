# Backend API URL (opcional, caso utilize backend próprio)
CONFIG_API_URL=http://localhost:3333

# Chave de Acesso do Web3Forms para o formulário "Fale Conosco"
# Obtenha uma chave gratuita em: https://web3forms.com
CONFIG_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Analytics proxy (SERVER-ONLY: never prefix these with CONFIG_, which would publish them in the bundle).
# The Vite dev/preview server forwards /analytics/* to this backend and adds the shared secret;
# in production the vercel.json route does the same from the Vercel project's environment variables.
ANALYTICS_API_URL=http://localhost:3333
# Must equal the backend's ANALYTICS_PROXY_SECRET (at least 32 characters).
ANALYTICS_PROXY_SECRET=replace-with-the-backend-analytics-proxy-secret

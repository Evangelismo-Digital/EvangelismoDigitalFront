    "@types/mdx": "2.0.13",
    "bootstrap": "^5.3.5",
    "puppeteer-core": "23.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.5.3",
    "zod": "^3.25.76"

{
  "name": "evangelismodigital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "prebuild": "npm run generate:sitemap",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:mutation": "stryker run --incremental",
    "prepush": "bash scripts/prepush.sh",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts"
